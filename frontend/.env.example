# Frontend Environment Variables
# Copy to .env and fill in your values.
# cp .env.example .env

# ── BACKEND URLS ──────────────────────────────────────────────────
# Railway backend URL (e.g. https://your-app.up.railway.app)
# For local dev: http://localhost:3000
VITE_BACKEND=http://localhost:3000/api/v1
VITE_BACKEND_SOCKET_IO=http://localhost:3000
VITE_BACKEND_IMAGES_BASE_URL=http://localhost:3000

# The full frontend URL (used in auth redirects, emails, etc.)
VITE_FRONTEND_DOMAIN=http://localhost:5173

# ── STRIPE (optional — leave blank if not using billing) ──────────
# Get your price ID from: https://dashboard.stripe.com/products
VITE_STRIPE_PRODUCT_SUBSCRIPTION_KEY=
