# ─────────────────────────────────────────────────────────────────
#  RestroPRO SaaS — Environment Variables
#  Copy this file to .env and fill in your values.
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────
# Railway MySQL: copy from Railway dashboard → Variables tab
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/restropro_saas"

# ── APP ───────────────────────────────────────────────────────────
PORT=3000

# Your Vercel frontend URL (e.g. https://your-app.vercel.app)
# For local dev: http://localhost:5173
FRONTEND_DOMAIN="http://localhost:5173"

# Just the domain part, no protocol (used for cookies)
# For local dev: localhost
FRONTEND_DOMAIN_COOKIE="localhost"

# ── JWT / AUTH ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_random_64_char_string

JWT_EXPIRY=15m
JWT_EXPIRY_REFRESH=30d

# Milliseconds — must match JWT_EXPIRY values above
COOKIE_EXPIRY=900000          # 15 minutes
COOKIE_EXPIRY_REFRESH=2592000000  # 30 days

PASSWORD_SALT=10

# ── ENCRYPTION ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_me_with_random_string

# ── EMAIL ─────────────────────────────────────────────────────────
# Recommended free options:
#   Resend (resend.com) — 3,000 emails/month free
#   Mailtrap (mailtrap.io) — free for dev/testing
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_EMAIL=you@yourdomain.com
SMTP_PASSWORD=re_your_resend_api_key_here

# ── STRIPE (optional — leave blank to disable billing) ────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG_ID=
