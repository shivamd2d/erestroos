# Backend Environment Variables
# See root .env.example for full documentation.
# Copy to .env: cp .env.example .env

DATABASE_URL="mysql://root:password@localhost:3306/restropro_saas"

PORT=3000
FRONTEND_DOMAIN="http://localhost:5173"
FRONTEND_DOMAIN_COOKIE="localhost"

JWT_SECRET=replace_me_with_random_64_char_string
